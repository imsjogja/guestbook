APP_ENV=development
APP_DEBUG=false
APP_PUBLIC_URL=https://api-dev.guestflow.id

DB_HOST=db
DB_PORT=5432
DB_USER=guestflow_dev
DB_PASSWORD=replace-with-development-db-password
DB_NAME=guestflow_dev
DB_SSL_MODE=disable

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=replace-with-development-jwt-secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h

WHATSAPP_ENABLED=true
GOWA_BASIC_AUTH=gowa-dev:replace-with-development-gowa-password
WHATSAPP_GOWA_API_URL=http://gowa:3000
WHATSAPP_GOWA_DEVICE_ID=guestflow-development
WHATSAPP_GOWA_USERNAME=gowa-dev
WHATSAPP_GOWA_PASSWORD=replace-with-development-gowa-password
WHATSAPP_GOWA_WEBHOOK_SECRET=replace-with-development-gowa-webhook-secret

GITHUB_ISSUE_NOTIFICATIONS_ENABLED=true
GITHUB_ISSUE_WEBHOOK_TOKEN=replace-with-development-github-webhook-token
GITHUB_ISSUE_WHATSAPP_TO=6281234567890
GITHUB_ISSUE_ALLOWED_REPOSITORIES=imsjogja/guestbook,imsjogja/guestbook-ui,imsjogja/guestbook-landing

EMAIL_ENABLED=false
EMAIL_FROM=no-reply@guestflow.id
EMAIL_FROM_NAME=GuestFlow Development
EMAIL_USE_TLS=false

MIDTRANS_IS_PRODUCTION=false
